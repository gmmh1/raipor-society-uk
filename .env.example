# -------------------------------
# Core
# -------------------------------
PROJECT_NAME=raipor-society-uk
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------
# Database
# -------------------------------
POSTGRES_DB=raipor
POSTGRES_USER=raipor
POSTGRES_PASSWORD=raipor_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raipor:raipor_dev_password@postgres:5432/raipor

# -------------------------------
# Redis / Celery
# -------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------------
# API Credentials (replace with real secrets)
# -------------------------------
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
PAYPAL_CLIENT_ID=replace
PAYPAL_CLIENT_SECRET=replace
PAYPAL_WEBHOOK_ID=replace
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=replace
WHATSAPP_PHONE_NUMBER_ID=replace
VAPID_PUBLIC_KEY=replace
VAPID_PRIVATE_KEY=replace
VAPID_CLAIM_EMAIL=admin@raipursociety.uk
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@raiporsociety.org.uk

# -------------------------------
# Authentication
# -------------------------------
AUTH_THROTTLE_RATE=5/min

# -------------------------------
# Storage (MinIO / S3-compatible)
# -------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=raipor-documents
S3_REGION=us-east-1

# -------------------------------
# AI / RAG
# -------------------------------
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL=bge-small

# -------------------------------
# Shop
# -------------------------------
SHOP_ORDER_RESERVATION_TIMEOUT_MINUTES=30

# -------------------------------
# Web / Deployment
# -------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_ENVIRONMENT=development
WEB_APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:8000
VERCEL_PROJECT_ID=replace
VERCEL_ORG_ID=replace
CLOUDFLARE_ZONE_ID=replace

# -------------------------------
# Monitoring
# -------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
